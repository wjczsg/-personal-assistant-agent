# 大模型服务的地址；OpenAI、硅基流动、DeepSeek、Ollama 等兼容服务都可以填写。
LLM_BASE_URL=https://api.openai.com/v1
# 大模型的密钥；没有密钥时程序会自动进入演示模式。
LLM_API_KEY=
# 要使用的模型名称；请根据你的服务商修改。
LLM_MODEL=gpt-4o-mini
CONTEXT_INPUT_BUDGET_TOKENS=5000
# SQLite 数据库文件名；它会自动创建在项目根目录。
DATABASE_FILE=assistant.db
# 长期记忆的 Chroma 距离阈值；数值越小越严格，建议结合审计结果调整。
MEMORY_DISTANCE_THRESHOLD=0.9
